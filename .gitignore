# Source snapshot: keep local evidence, runtimes, models and media out of Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE.md
!/THIRD_PARTY_NOTICES.md
!/pytest.ini
!/src/
!/tests/
!/requirements/
!/tools/
!/docs/

/docs/*
!/docs/SOURCE_PROVENANCE.json
!/docs/donor-notices/

**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.db
*.db-*
*.sqlite*
*.log
*.mp4
*.avi
*.mov
*.mkv
*.pt
*.pth
*.onnx
*.engine
*.whl
*.zip
*.exe
*.dll
*.pyd
*.lnk
